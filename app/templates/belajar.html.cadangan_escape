{% extends 'dasar.html' %}
{% block isi %}

<div style="max-width:720px">
  <span class="eyebrow">{{ ikon('book-open', 13) }} BELAJAR</span>
  <h1>Materi, kamus, dan ruang uji</h1>
  <p class="besar">
    Geser slider di setiap istilah — kamu akan melihat sendiri bagaimana
    angkanya berubah, bukan sekadar membaca definisi.
  </p>
</div>

<!-- ══════ PITA TAB (19Sep26) ══════ -->
<div class="pita-tab" role="tablist">
  <a href="#tab-1" class="aktif" id="pa-1" role="tab" onclick="bukaTab(1);return false">
