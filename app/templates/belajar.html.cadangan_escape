      if (a >= 0.70) return ['pita-hijau', 'Cukup', 'Alpha 0,70–0,90 itu yang paling sering dipakai dan paling aman.'];
      if (a >= 0.60) return ['pita-amber', 'Marginal', 'Alpha 0,60–0,70 masih sering dipakai di penelitian eksploratif, tapi sebaiknya ada item yang diperbaiki.'];
      return ['pita-merah', 'Rendah', 'Alpha di bawah 0,60 — ada item yang tidak sejalan. Cari item mana yang kalau dibuang membuat alpha naik.'];
    },
    spss: 'Analyze → Scale → Reliability Analysis → tombol Statistics → centang Scale if item deleted. Lihat kolom Cronbach\u2019s Alpha if Item Deleted.',
    kenapa: [
      'Ada pertanyaan yang maksudnya tidak sejalan dengan pertanyaan lain.',
