      return `<line x1="20" y1="96" x2="380" y2="96" stroke="#EDE6D8" stroke-width="22" stroke-linecap="round"/>
        <line x1="20" y1="96" x2="${20 + lebar}" y2="96" stroke="${c}" stroke-width="22" stroke-linecap="round"/>
        <line x1="${20 + 0.70 * 350}" y1="60" x2="${20 + 0.70 * 350}" y2="132"
              stroke="#4E8A5A" stroke-width="2" stroke-dasharray="4 3"/>
        <text x="${20 + 0.70 * 350}" y="52" text-anchor="middle" font-size="11" fill="#4E8A5A">0,70 ambang<\/text>
        <text x="${20 + 0.90 * 350}" y="152" text-anchor="middle" font-size="11" fill="#B5762A">0,90<\/text>`;
    }
  }
};

let kunci = 'hetero';
const el = id => document.getElementById(id);

function gambar() {
  const k = KAMUS[kunci];
  const v = parseInt(el('slider').value, 10);
  const angka = k.format(v);
  const [kelas, label, pesan] = k.tafsir(v);
  let warna = '#2E7D6F';
  if (kelas === 'pita-amber') warna = '#B5762A';
  if (kelas === 'pita-merah') warna = '#A85A5A';
  if (kelas === 'pita-hijau') warna = '#4E8A5A';
  if (kelas === 'pita-abu') warna = '#9A9086';

  el('angka').textContent = angka;
  el('grafik').innerHTML = k.gambar(v, warna);
  // ⚠️ KALIMAT PENEGAS (20Sep26, permintaan Bos): "tidak ada corong berarti
  // bagus/sehat". `tafsir` tetap dipakai untuk pita & istilah lain; kalimat
  // panjangnya diambil dari kalimatTafsir bila entri punya. Entri lama TIDAK
  // punya → otomatis pakai `pesan` seperti sebelumnya (tidak ada yang rusak).
  el('pesan-isi').innerHTML =
    (typeof kalimatTafsir === 'function')
      ? kalimatTafsir(kunci, v, pesan) : pesan;
  el('pita-hasil').className = 'pita ' + kelas;
  el('pita-hasil').textContent = label;
  el('spss').textContent = k.spss;

  // ⚠️ "Kenapa bisa terjadi?" (18Sep26) — sebab-sebabnya, bukan cuma artinya.
  // Kalau istilah belum punya daftar ini, sembunyikan kotaknya (jangan
  // tampilkan kotak kosong yang membingungkan).
  const kotakKenapa = el('kenapa-kotak');
  const isiKenapa = el('kenapa-isi');
  const daftar = k.kenapa || [];
  if (daftar.length) {
    isiKenapa.innerHTML = daftar.map(t => '<li>' + t + '<\/li>').join('');
    kotakKenapa.hidden = false;
  } else {
    kotakKenapa.hidden = true;
  }
}

function pilih(k) {
  kunci = k;
  // ⚠️ KARTU UJI t (18Sep26): istilah 'ujit' TIDAK memakai pola kamus (tak ada
  // slider, tak ada satu angka). Jadi panel kamus disembunyikan dan kartu uji t
  // ditampilkan — kalau tidak, halaman akan menampilkan panel kosong.
  const kartu = document.getElementById('kartu-ujit');
  // ⚠️ AKAR (19Sep26) — yang disembunyikan WAJIB `.papan` (panel ISI), BUKAN
  // `.kamus-kisi`, karena pita tombol istilah ada DI DALAM .kamus-kisi. Kalau
  // seluruh .kamus-kisi disembunyikan, tombolnya ikut hilang → user tidak bisa
  // pindah ke istilah lain lagi. Bos minta: "seperti tab tab yang lain" — pita
  // tetap ada, hanya ISI-nya yang berganti.
  const panelKamus = document.querySelector('#tab-1 .papan');
  if (k === 'ujit') {
    if (panelKamus) panelKamus.hidden = true;
    if (kartu) kartu.hidden = false;
    document.querySelectorAll('.kamus-tombol').forEach(b =>
      b.classList.toggle('aktif', b.dataset.k === k));
    return;
  }
  if (panelKamus) panelKamus.hidden = false;
  if (kartu) kartu.hidden = true;
  const kk = KAMUS[k];
  if (!kk) return;
  el('judul').textContent = kk.judul;
  el('arti').innerHTML = kk.arti;
  el('label-slider').textContent = kk.tanya;
  // ⚠️ AKAR (20Sep26) — BATAS SLIDER DISETEL DARI ENTRI, bukan dipaku 0…100.
  // Normalitas butuh −100…+100 (bisa miring dua arah); istilah lain tetap
  // 0…100 karena tidak punya `min`/`maks`. Tanpa ini, salah satu istilah
  // pasti rusak: normalitas kehilangan sisi kiri, ATAU istilah lain
  // kehilangan separuh rentangnya.
  el('slider').min = (kk.min !== undefined) ? kk.min : 0;
  el('slider').max = (kk.maks !== undefined) ? kk.maks : 100;
  el('slider').value = (kk.bawaan !== undefined) ? kk.bawaan : 35;
  // Tombol pintasan hanya masuk akal untuk hetero (yang punya keadaan
  // "sehat/sakit" satu arah). Istilah lain disembunyikan — JANGAN
  // menampilkan tombol yang tidak berfungsi.
  const barisPintasan = document.getElementById('pintasan-baris');
  if (barisPintasan) barisPintasan.hidden = (k !== 'hetero');
  el('kiri').textContent = kk.kiri;
  el('kanan').textContent = kk.kanan;
  document.querySelectorAll('.kamus-tombol').forEach(b =>
    b.classList.toggle('aktif', b.dataset.k === k));
  gambar();
}

/* ⚠️ CATATAN (19Sep26): fungsi bawaKeAtas() DIHAPUS — itu tambalan yang
