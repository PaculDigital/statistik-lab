         preserveAspectRatio="xMidYMid meet"
         role="img" aria-label="Diagram istilah statistik"></svg>

    <div class="baris-antara" style="margin-top:14px">
      <div>
        <div class="samar">Angka yang terbaca</div>
        <div class="angka-besar" id="angka">0.00</div>
      </div>
