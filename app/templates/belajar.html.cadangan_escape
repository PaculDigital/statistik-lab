        <text x="200" y="172" text-anchor="middle" font-size="12" font-weight="700"
              fill="#2B2722">tumpang tindih ${persenTumpang}%<\/text>
        <text x="200" y="190" text-anchor="middle" font-size="10.5"
              fill="#6B6259">${persenTumpang === 0
