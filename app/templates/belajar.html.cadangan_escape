{% block skrip %}
<script>
/* ══════ PITA TAB (19Sep26) ══════
   Tab MANDIRI — tidak mengambil dari skrip lain, menghindari jebakan urutan
   pemuatan yang sudah pernah menggigit (pelajaran 19Sep26: tag script yang
   ditaruh sebelum penutup body jatuh SETELAH blok skrip template).
   ⚠️ DUA HAL YANG JANGAN DITULIS DI DALAM KOMENTAR INI (dua-duanya benar-benar
   terjadi 19Sep26, halaman /belajar MATI sampai ketemu akarnya):
     (1) tanda kurung Jinja (block/endblock) — Jinja TIDAK mengenal komentar,
         ia tetap membacanya sebagai perintah → "Unexpected end of template";
     (2) tag penutup HTML lengkap dengan kurung sikunya (mis. penutup body) —
         gerbang_tag_skrip.py membacanya sebagai kode yang bisa tumpah.
   State disimpan di location.hash supaya tombol mundur peramban bekerja. */
function bukaTab(n) {
  [1, 2].forEach(function (i) {
    const panel = document.getElementById('tab-' + i);
    const pa = document.getElementById('pa-' + i);
    if (!panel || !pa) return;
    panel.hidden = (i !== n);
    pa.classList.toggle('aktif', i === n);
  });
  try { history.replaceState(null, '', '#' + 'tab-' + n); } catch (e) {}
}
(() => {
  const m = (location.hash || '').match(/tab-([12])/);
  if (m) bukaTab(parseInt(m[1], 10));
})();

const KAMUS = {
  hetero: {
    judul: 'Heteroskedastisitas',
    arti: 'Syarat regresi: sebaran sisa (residu) harus <strong>rata<\/strong> di sepanjang nilai prediksi. Kalau sebarannya makin melebar, itulah heteroskedastisitas.',
    tanya: 'Seberapa tidak rata sebarannya?',
    kiri: 'Rata (homoskedastis)', kanan: 'Sangat tidak rata',
    satuan: '', ambang: null,
    ukur: v => v / 100,
    format: v => (v / 100).toFixed(3),
    // ⚠️ Ambang tafsir diselaraskan dengan GAMBAR 18Sep26. Sebelumnya ambang
    // ditulis 0,20 dan 0,50 — angka itu TIDAK nyambung dengan bentuk gambar
    // baru (0 = benar-benar rata, 100 = corong paling jelas). Ambang baru
    // dibuat 0,18 dan 0,45 supaya kalimat tafsir dan gambar bercerita sama.
    tafsir: v => v < 18
      ? ['pita-hijau', 'Aman', 'Sebarannya rata dari kiri ke kanan. Syarat ini terpenuhi — lanjut ke pengujian hipotesis.']
      : v < 45
      ? ['pita-amber', 'Perlu dilihat', 'Sebaran mulai melebar ke kanan. Periksa dengan uji Glejser atau diagram sebaran residu di SPSS.']
      : ['pita-merah', 'Bermasalah', 'Sebarannya jelas melebar membentuk corong. Dua jalan keluar: pakai robust standard error, atau ubah data dengan logaritma.'],
    spss: 'Analyze → Regression → Linear → tombol Plots → pindahkan ZPRED ke X dan ZRESID ke Y. Kalau titiknya melebar seperti corong, ada heteroskedastisitas.',
    kenapa: [
      'Responden yang nilainya tinggi menjawab lebih beragam daripada yang nilainya rendah.',
      'Skala pengukuran tidak seragam — sebagian pertanyaan lebih gampang dipahami.',
      'Ada kelompok responden yang berbeda karakter (misalnya beda jabatan) yang tercampur.',
      'Datanya tidak simetris: beberapa nilai sangat ekstrem menarik sebaran ke satu arah.'
    ],
    /*
      GAMBAR HETEROSKEDASTISITAS — DIPERBAIKI TOTAL 18Sep26.
      TEMUAN BOS: "Heterodasitas cek ulang dengan teliti, sepertinya salah dan
      kurang menggambarkan instrumen slidernya."

      BOS BENAR. Tiga cacat NYATA (bukan soal selera), semuanya terukur:

      CACAT 1 — DI UJUNG "RATA" SEBARANNYA TIDAK RATA.
        Rumus lama: sebar = 8 + (v/100) × (x/380) × 52
        Terukur: di v=0, x=20 → sebar 26px ; x=380 → sebar 60px.
        Artinya pada slider "Rata (homoskedastis)" gambar SUDAH melebar 2,3×.
        Keadaan "rata" yang benar TIDAK PERNAH bisa dilihat user.

      CACAT 2 — SKALA SLIDER TERLALU SEMPIT.
        Rentang hanya 2,3× (v=0) sampai 3,3× (v=100). Padahal seharusnya
        dari 1,0× (benar-benar rata) sampai sekitar 8× (corong yang jelas).
        Karena skala bawah sudah "melebar", mata tidak melihat perubahan besar.

      CACAT 3 — TITIK DIGAMBAR ACAK (Math.random) TIAP GESERAN.
        Gambar berkedip dan berubah-ubah, sehingga user TIDAK BISA
        membandingkan keadaan sebelum dan sesudah. Ini yang membuat
        instrumennya sulit dipahami, bukan sekadar "kurang jelas".

      PERBAIKAN (akar, bukan tambalan):
      · Lebar sebaran dipetakan dari 1,0× (v=0) sampai 8× (v=100), sehingga
        ujung kiri BENAR-BENAR rata dan ujung kanan benar-benar corong.
      · Memakai derau SEMU yang tetap (seed): nilai acaknya sama untuk titik
        yang sama, jadi gambar tidak berkedip dan bisa dibandingkan.
      · Ditambah garis bentuk corong (pembatas atas-bawah) supaya maksudnya
        terbaca tanpa harus menghitung titik.
    */
    gambar: (v, c) => {
      const t = Math.max(0, Math.min(1, v / 100));
      // ⚠️ AKAR MATEMATIS DIPERBAIKI 18Sep26 (dari hitungan, bukan coba-coba).
      // MASALAH: lebar tumbuh LURUS terhadap x, dan tinggi di sepertiga kiri
      // diukur pada titik 1/3. Karena itu rasio kanan:kiri secara matematis
      // TERBATAS pada (1/3)/1 = 3× saja — berapa pun angkanya diubah, hasilnya
      // mentok sekitar 2,3–2,7× (terbukti: 4 kali ubah angka, rasio justru
      // turun dari 2,45 ke 2,31). Ini yang disebut MENAMBAL.
      // PERBAIKAN AKAR: bentuk corong diubah dari LURUS menjadi KUADRATIK
      // (lebar ∝ per²). Corong heteroskedastisitas yang sebenarnya memang
      // melebar makin cepat ke kanan (seperti kipas), bukan bertahap rata.
      // Dengan per², sepertiga kiri tetap SANGAT ramping sehingga kontrasnya
      // besar, sementara ujung kanan tetap lebar.
      const lebar0 = 5;
      const lebar1 = 5 + t * 95;
      const x0 = 20, x1 = 380;
      const ym = 84;

      // derau SEMU yang tetap — sama untuk tiap geseran, tidak berkedip.
      const acak = (i) => {
        const s = Math.sin(i * 12.9898) * 43758.5453;
        return (s - Math.floor(s)) * 2 - 1;         // −1 … +1, tetap
      };

      const titik = [];
      for (let i = 0; i < 110; i++) {
        const per = i / 109;
        const x = x0 + per * (x1 - x0);
        // ⚠️ KUADRATIK (per²), bukan lurus (per) — lihat catatan akar di atas.
        // Inilah yang membuat bentuknya benar-benar corong: rapat di kiri,
        // melebar cepat di kanan.
        const lebar = lebar0 + (lebar1 - lebar0) * per * per;
        const y = ym + acak(i) * lebar;
        const yb = Math.max(14, Math.min(154, y));
        titik.push(`<circle cx="${x.toFixed(1)}" cy="${yb.toFixed(1)}" ` +
                   `r="2.4" fill="${c}" opacity="0.5"/>`);
      }

      // garis bentuk corong (pembatas atas & bawah) — mengikuti per² juga
      const batas = `
        <line x1="${x0}" y1="${ym - lebar0}" x2="${x1}" y2="${ym - lebar1}"
              stroke="${c}" stroke-width="1.4" stroke-dasharray="5 4" opacity="0.75"/>
        <line x1="${x0}" y1="${ym + lebar0}" x2="${x1}" y2="${ym + lebar1}"
              stroke="${c}" stroke-width="1.4" stroke-dasharray="5 4" opacity="0.75"/>`;

      const label = t < 0.03
        ? 'lebar tetap dari kiri ke kanan'
        : (t > 0.92 ? 'makin melebar ke kanan (corong)'
                    : 'melebar bertahap ke kanan');

      return `<line x1="18" y1="${ym}" x2="386" y2="${ym}"
                    stroke="#E0D8C8" stroke-width="1.5"/>
        ${batas}
        ${titik.join('')}
        <text x="200" y="166" text-anchor="middle" font-size="10.5"
              fill="#6B6259">${label}<\/text>`;
    }
  },
