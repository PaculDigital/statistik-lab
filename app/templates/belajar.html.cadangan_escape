      const jarakPusat = 30 + (1 - r) * 120;   // 150 (v=0) → 30 (v=100)
      const x1 = 200 - jarakPusat / 2;
      const x2 = 200 + jarakPusat / 2;
      const cy = 92;

      // tumpang tindih dihitung dari GEOMETRI, bukan angka slider (jangan menipu)
      const tumpang = Math.max(0, 2 * R - Math.abs(x2 - x1));
      const persenTumpang = Math.round(tumpang / (2 * R) * 100);

      return `
        <circle cx="${x1}" cy="${cy}" r="${R}" fill="${c}" opacity="0.32"/>
        <circle cx="${x2}" cy="${cy}" r="${R}" fill="${c}" opacity="0.32"/>
