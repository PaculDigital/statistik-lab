/* ══════════════════════════════════════════════════════════════════════════
   KETERANGAN AMBANG SIG. (19Sep26, ACC Bos) — slider pembanding.
   Tujuan: mahasiswa LEMAH membandingkan angka. Mereka tidak yakin apakah hasil
   0,008 itu lebih kecil atau lebih besar dari 0,05 → signifikan atau tidak.
   Slider ini menunjukkan POSISI angka hasil temuan terhadap garis batas 0,05.
   Rentang 0,000–0,50 (OPSI A) — batas 0,05 tetap bergaris, semua bisa digeser.
   ══════════════════════════════════════════════════════════════════════════ */
function ambGambar(v) {
  v = Math.max(0, Math.min(0.50, v));
  const persen = (v / 0.50) * 100;
  const teks = v.toFixed(3).replace('.', ',');

  const pin = document.getElementById('amb-pin');
  const nilai = document.getElementById('amb-nilai');
  const jawab = document.getElementById('amb-jawab');
  if (pin) pin.style.left = persen + '%';
  if (nilai) nilai.textContent = teks;
  if (!jawab) return;

  // ⚠️ AKAR (19Sep26, terukur 2×): di dalam <script>, tag HTML penutup WAJIB
  // ditulis dengan SATU backslash (`<\/strong>`) supaya tidak dibaca sebagai
  // penutup skrip. Wulan sempat menulis DUA backslash (`<\\/strong>`) → backslash
  // ikut tercetak → teks bocor "…<\/strong>…" MUNCUL DI LAYAR.
  // Sekarang dipakai PEMISAH: `besar` dan `ket` dipecah jadi potongan teks biasa
  // (tanpa tag sama sekali) + bendera mana yang perlu dicetak tebal.
  let besar, potongan, kelas;
  if (v < 0.05) {
    besar = 'Sig. ' + teks + ' → SIGNIFIKAN';
    potongan = [
      { t: teks },
      { t: ' lebih kecil', tebal: true },
      { t: ' dari batas 0,05 → pengaruhnya nyata, bukan kebetulan.' }
    ];
    if (v > 0 && v < 0.01) {
      potongan.push({ t: ' Angka sekecil ini biasanya ditulis p < 0,001.' });
    }
    kelas = ' hijau';
  } else if (v <= 0.10) {
    besar = 'Sig. ' + teks + ' → MARGINAL';
    potongan = [
      { t: 'Hasilnya ' },
      { t: 'di batas', tebal: true },
      { t: ' (0,05–0,10). Perlu dibahas hati-hati — jangan dipaksa jadi signifikan.' }
    ];
    kelas = ' kuning';
  } else {
    besar = 'Sig. ' + teks + ' → TIDAK SIGNIFIKAN';
    potongan = [
      { t: teks },
      { t: ' lebih besar', tebal: true },
      { t: ' dari batas 0,05 → belum cukup bukti. Tandanya juga belum bisa dipakai.' }
    ];
    kelas = ' abu';
  }
  jawab.className = 'catatan amb-jawab-' + kelas.trim();
  // ⚠️ AKAR (19Sep26, terukur 3×): di dalam <script> TIDAK ADA satu pun cara
  // aman menuliskan tag HTML lewat string — gerbang tag skrip menuntut backslash,
  // tapi backslash itu ikut tercetak jadi teks di layar. Jadi di sini tag
  // DIBUAT LEWAT DOM: createElement + textContent. Nol string HTML, nol escape,
  // mustahil bocor. Kata yang perlu tebal dibuat <strong> oleh DOM, bukan teks.
  jawab.textContent = '';
  const divBesar = document.createElement('div');
  divBesar.className = 'amb-besar';
  divBesar.textContent = besar;
  const divKet = document.createElement('div');
  divKet.className = 'amb-ket';
  potongan.forEach(function (bag) {
    if (bag.tebal) {
      const s = document.createElement('strong');
      s.textContent = bag.t;
      divKet.appendChild(s);
    } else {
      divKet.appendChild(document.createTextNode(bag.t));
    }
  });
  jawab.appendChild(divBesar);
  jawab.appendChild(divKet);
}

(function ambPasang() {
  const inp = document.getElementById('amb-sig');
  const ges = document.getElementById('amb-geser');
  if (!inp || !ges) return;

  ges.addEventListener('input', function () {
    const v = parseInt(this.value, 10) / 1000;
    inp.value = v.toFixed(3).replace('.', ',');
    ambGambar(v);
  });

  function dariKotak() {
    // terima "0,008" maupun "0.008"; juga "0,00 8" dan spasi lain
    const v = parseFloat(String(inp.value).replace(',', '.').replace(/[^0-9.]/g, ''));
    if (isNaN(v)) return;
    ges.value = Math.round(Math.max(0, Math.min(0.50, v)) * 1000);
    ambGambar(Math.max(0, Math.min(0.50, v)));
  }
  inp.addEventListener('input', dariKotak);
  inp.addEventListener('change', dariKotak);
  // kalau user tekan Enter, hilangkan fokus supaya papan angka HP menutup
  inp.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); this.blur(); dariKotak(); }
  });

  ambGambar(0.008);
})();
</script>
