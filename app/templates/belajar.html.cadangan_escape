              stroke="#A85A5A" stroke-width="1.5" stroke-dasharray="4 3"/>
        <text x="${batasKanan - 4}" y="24" text-anchor="end" font-size="10"
              font-weight="700" fill="#A85A5A">batas 0,05 →<\/text>

        <line x1="${xPaman}" y1="152" x2="${xPaman}" y2="52"
              stroke="#2B2722" stroke-width="2.5"/>
        <circle cx="${xPaman}" cy="52" r="4" fill="#2B2722"/>
        <text x="${xPaman}" y="44" text-anchor="middle" font-size="11"
              font-weight="700" fill="#2B2722">p = ${p.toFixed(3)}<\/text>

        <text x="200" y="140" text-anchor="middle" font-size="10.5"
              fill="#6B6259">paling ramai = kebetulan biasa<\/text>`;
    }
